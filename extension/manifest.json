{
  "manifest_version": 3,
  "name": "QS",
  "version": "1.0.0",
  "description": ".",
  "permissions": ["activeTab"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "commands": {
    "solve": {
      "suggested_key": { "mac": "MacCtrl+Q", "default": "Ctrl+Q" },
      "description": "Solve"
    }
  },
  "action": {}
}
